# Скопировать в /opt/personal-hub/.env (права 600), секреты не коммитить
BOT_TOKEN=
ANTHROPIC_API_KEY=
ADMIN_TG_ID=
# Ключ шифрования секретов подключений. Сгенерировать:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CONNECTIONS_KEY=
# На сервере без вывода значения: см. ops/DEPLOY.md, шаг «.env»
WEB_BASE_URL=https://desk.example.com
# Имя бота без @; если пусто, берётся из getMe при старте
# BOT_USERNAME=
# WEB_PORT=8080
# SESSION_DAYS=30
# DB_PATH=/data/hub.db
# BACKUP_DIR=/data/backups
# BRIEF_TIME=09:00
# DAILY_TOKENS_IN=2000000
# DAILY_TOKENS_OUT=200000
# MODEL_FAST=claude-haiku-5-5
# MODEL_SMART=claude-sonnet-5-5
# Белый список tg_id через запятую; пусто = без ограничения (админ разрешён всегда)
ALLOWED_TG_IDS=
# Имена вместо Telegram-имён: tg_id=Имя через запятую
USER_NAMES=
